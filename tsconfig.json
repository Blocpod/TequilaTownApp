{
  // Type-checks the Netlify backend (server/, netlify/functions) and the shared
  // contract. The mobile app has its own tsconfig under mobile/.
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "netlify/**/*.mts", "vitest.config.ts"],
  "exclude": ["node_modules", "mobile", "web"]
}
