# Tequila Town backend — environment variables.
# Set these in Netlify (Site configuration → Environment variables, scope "Functions").
# For local dev, copy to .env (git-ignored); `netlify dev` loads it automatically.

# ---------------------------------------------------------------------------
# REQUIRED in every deployed context (production, previews, branch deploys).
# Locally they fall back to fixed DEV values with a warning. Deployed without
# them, auth/scan endpoints answer 500 NOT_CONFIGURED.
# ---------------------------------------------------------------------------

# HS256 signing key for access tokens. 32+ random bytes, e.g. `openssl rand -base64 48`.
# Rotating it invalidates all access tokens (401 UNAUTHORIZED); refresh tokens are
# independent of it, so an app that refreshes on 401 recovers without a re-login.
JWT_SECRET=

# HMAC key for venue QR codes. MUST match the secret used to print them
# (`npm run qr`). Changing it invalidates every printed code.
QR_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Optional — features switch on when set (see GET /api/config).
# ---------------------------------------------------------------------------

# The Oracle (chat, La Memoria Viva, El Ojo, AI personas). Without it: AI routes → 501 NOT_CONFIGURED,
# personas use the deterministic fallback.
OPENROUTER_API_KEY=
# Model overrides (defaults shown).
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# API base override (proxy, or a local mock for offline testing).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Password reset by email (Resend). Both required, otherwise /api/auth/password/* → 501.
RESEND_API_KEY=
# Must be a verified Resend sender, e.g. "Tequila Town <no-reply@tequilatown.com>"
RESET_EMAIL_FROM=

# Sign in with Apple: comma-separated accepted audiences (iOS bundle id, plus a
# Services ID if you add web sign-in). Default: com.tequilatown.app
APPLE_BUNDLE_IDS=com.tequilatown.app
# Set to "false" to hide/disable Sign in with Apple.
# APPLE_SIGN_IN_ENABLED=true

# Staff/admin endpoints (/api/admin/*) via the `x-admin-key` header. Unset → 501.
ADMIN_API_KEY=

# Canonical public origin for absolute URLs (avatars, memories, share links, QR sheets).
# Defaults to the request origin.
# PUBLIC_BASE_URL=https://tequilatown.com

# Store links shown on /m/:id and /s/:code pages.
APP_STORE_URL=
PLAY_STORE_URL=

# scrypt cost (N) for password hashing. Default 131072 (2^17). Don't lower in production.
# SCRYPT_N=131072
