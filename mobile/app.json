{
  "expo": {
    "name": "Tequila Town",
    "slug": "tequila-town",
    "description": "Your passport to Tequila Town, the immersive agave experience. Explore twelve zones, collect stamps, claim your ticket, and meet the Oracle.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "tequilatown",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3E9D2",
    "primaryColor": "#AD3A00",
    "ios": {
      "bundleIdentifier": "com.tequilatown.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tequilatown.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#AD3A00",
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "monochromeImage": "./assets/app/adaptive-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/app/favicon.png",
      "name": "Tequila Town",
      "themeColor": "#AD3A00",
      "backgroundColor": "#F3E9D2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E9D2",
          "image": "./assets/app/splash-logo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tequila Town uses your camera to scan festival QR codes, take your La Memoria Viva portrait, and identify tequila bottles.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile picture, La Memoria Viva portrait, or bottle identification.",
          "cameraPermission": "Tequila Town uses your camera to take your La Memoria Viva portrait and profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your La Memoria Viva portraits to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
